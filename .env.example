# ============================================================
# 架构-执行双模型编排器 · 环境变量模板
#
# 复制为 .env 后填写，或在界面右上角 ⚙ 里填写（界面保存的值优先）。
# 注意：.env 已在 .gitignore 中排除，切勿提交真实密钥。
# ============================================================

# ---------- 服务 ----------
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8787

# ---------- 中转网关（公共）----------
# 一个 OpenAI 兼容的中转地址即可同时提供 GPT 与 DeepSeek。
# 例：https://your-relay.example.com/v1
RELAY_BASE_URL=
RELAY_API_KEY=
# chat_completions（默认，兼容面最广）或 responses
RELAY_WIRE_API=chat_completions

# ---------- 架构段（纲领）----------
ARCHITECT_MODEL=gpt-5
# 若架构段走另一条中转，填写下面两项；留空则回落到 RELAY_*
ARCHITECT_BASE_URL=
ARCHITECT_API_KEY=
ARCHITECT_WIRE_API=

# ---------- 执行段（落地）----------
# 按你的中转实际模型名填写：deepseek-v4 / deepseek-v4-flash / deepseek-chat
EDITOR_MODEL=deepseek-v4
EDITOR_BASE_URL=
EDITOR_API_KEY=
EDITOR_WIRE_API=

# ---------- 行为 ----------
REQUEST_TIMEOUT_SECONDS=300
MAX_PLAN_STEPS=8
# 执行段给出的命令默认只展示不执行；确认风险后再打开
ALLOW_COMMAND_EXECUTION=false
# 喂给执行段的工作区文件条目上限（防止上下文爆炸）
CONTEXT_TREE_LIMIT=120
